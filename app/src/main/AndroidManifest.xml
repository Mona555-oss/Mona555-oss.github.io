<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alfleyla.zeituna">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.alfleyla" >
        <activity
            android:name=".auth.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.AuthActivity"
            android:exported="false" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".booking.BookingActivity"
            android:exported="false" />

        <activity
            android:name=".booking.CalendarBookingActivity"
            android:exported="true"
            android:label="Select Time"
            android:launchMode="singleTask">

            <!-- Old custom scheme for backward compatibility -->
            <intent-filter android:label="payment_return_custom">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="alfleyla" android:host="payment-success" />
            </intent-filter>

            <!-- New HTTPS return URL to avoid Sandboxing/ReCaptcha issues -->
            <intent-filter android:label="payment_return_web" android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="mona555-oss.github.io"
                      android:pathPrefix="/index.html" />
            </intent-filter>
        </activity>

        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:label="My Profile" />

        <activity
            android:name=".profile.TeacherDashboardActivity"
            android:exported="false"
            android:label="Teacher Dashboard" />

        <activity
            android:name=".profile.TeachersListActivity"
            android:exported="false"
            android:label="Our Teachers" />

        <activity
            android:name=".profile.PackageDetailsActivity"
            android:exported="false"
            android:label="Package Details" />

        <activity
            android:name=".profile.AccountActivity"
            android:exported="false"
            android:label="My Account" />

        <activity
            android:name=".booking.ServiceDetailsActivity"
            android:exported="false"
            android:label="Service Details" />

    </application>

</manifest>
