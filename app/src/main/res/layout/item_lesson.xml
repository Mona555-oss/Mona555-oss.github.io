<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lessonCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/turquoise_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvPreviousLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="previously scheduled time:"
                android:textSize="9sp"
                android:textColor="#666666"
                android:visibility="gone"
                android:layout_marginBottom="2dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvLessonDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 Jul"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvLessonTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/turquoise_dark" />

        </LinearLayout>

        <View
            android:id="@+id/lessonDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/turquoise_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/turquoise_dark"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLessonServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Individual Lesson"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvLessonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Confirmed"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/turquoise_dark" />

            <TextView
                android:id="@+id/tvScheduledAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="scheduled: -"
                android:textSize="10sp"
                android:textColor="@color/black"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/layoutReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason: -"
                    android:textSize="11sp"
                    android:textColor="#D32F2F" />

                <TextView
                    android:id="@+id/tvMoreReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="more"
                    android:textSize="11sp"
                    android:textColor="@color/turquoise_dark"
                    android:textStyle="bold"
                    android:paddingTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnschedule"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unschedule"
            android:textColor="@color/turquoise_primary"
            android:textSize="12sp"
            app:rippleColor="@color/turquoise_light" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>