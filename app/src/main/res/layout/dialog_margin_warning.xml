<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvMarginWarningTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booking Notice"
        android:textColor="@color/turquoise_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMarginWarningMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lessons have to be booked in 20 hours or more in advance. Please read our terms of service to know more."
        android:textColor="@color/black"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarginWarningOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:text="OK"
        android:textColor="@color/white"
        app:backgroundTint="@color/turquoise_primary"
        app:cornerRadius="8dp"/>

</LinearLayout>
